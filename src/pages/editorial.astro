---
const base = import.meta.env.BASE_URL;
import SectionLayout from "../layouts/SectionLayout.astro";
import Icon from "../components/Icon.astro";

const navItems = [
	{ id: "publicaciones", label: "Publicaciones" },
	{ id: "servicios-editoriales", label: "Servicios editoriales" },
	{ id: "convertite-en-autor", label: "¡Convertite en autor de una obra colaborativa!" },
];

const publicaciones = [
	{
		titulo: "Entre voces, puentes y aulas",
		tipo: "Libro colaborativo",
		anio: "2026",
		descripcion: "Esta producción presenta proyectos y reflexiones sobre la aplicación del Programa TransFORMAR@Cba en diferentes escuelas de nivel inicial, primario y secundario en la provincia de Córdoba.",
		imagen: base + "images/publicaciones/entre-voces-puentes-y-aulas.png",
	},
	{
		titulo: "Presencias transformadoras",
		tipo: "Libro",
		anio: "2025",
		descripcion: "Un libro que promueve el liderazgo docente y directivo desde la perspectiva del Bienestar Educativo.",
		imagen: base + "images/publicaciones/presencias-transformadoras.png",
	},
	{
		titulo: "La innovación pedagógica como construcción colectiva",
		tipo: "Libro colaborativo",
		anio: "2025",
		descripcion: "Una obra que recupera proyectos innovadores implementados en escuelas cordobesas con foco en la mejora educativa.",
		imagen: base + "images/publicaciones/innovacion-pedagogica-construccion-colectiva.png",
	},
	{
		titulo: "Proyectando Escuela",
		tipo: "Libro colaborativo",
		anio: "2024",
		descripcion: "Una obra que reúne propuestas para trabajar la normativa y legislación escolar en las escuelas desde la prevención y el enfoque de derechos.",
		imagen: base + "images/publicaciones/proyectando-escuela.png",
	},
	{
		titulo: "Puzzle",
		tipo: "Gestión directiva y práctica docente",
		anio: "2023",
		descripcion: "Una obra que presenta el trabajo colaborativo en la escuela como su gran fortaleza, junto con estrategias para implementarlo exitosamente.",
		imagen: base + "images/publicaciones/puzzle.png",
	},
	{
		titulo: "Una gestión con voz propia",
		tipo: "Producción colaborativa",
		anio: "2022",
		descripcion: "Una producción colaborativa que pone en el centro de la escena la experiencia de directivos de diferentes niveles y modalidades en la provincia de Córdoba.",
		imagen: base + "images/publicaciones/una-gestion-con-voz-propia.png",
	},
];

---

<SectionLayout
	title="Servicios Editoriales — Fundación Freinet"
	description="Publicaciones, materiales didácticos y servicios editoriales de la Fundación Freinet."
	eyebrow="Editorial"
	heroTitle="“Querer imprimir es querer comunicar a gran escala.”"
	heroDescription="— Célestin Freinet"
	theme="deep"
	navItems={navItems}
>
	<section id="intro" class="editorial-intro">
		<p>
			En Fundación Freinet acompañamos la creación, edición y publicación de proyectos
			educativos, académicos e institucionales, siguiendo la tradición iniciada por
			nuestro referente Célestin Freinet.
		</p>
		<p>
			Las ideas, proyectos, propuestas e iniciativas no han sido creadas para terminar
			sus vidas en un cajón o arrumbadas en una biblioteca sin que nadie las lea; antes
			bien, su propósito es inspirar a otros a seguir experimentando e impactando en la
			sociedad.
		</p>
		<p>
			Ofrecemos servicios de corrección, edición, diseño y asesoramiento editorial,
			adaptados a las necesidades de los autores e instituciones.
		</p>
	</section>

	<section id="publicaciones">
		<span class="eyebrow">Publicaciones</span>
		<h2>Catálogo</h2>
		<div class="pub-grid">
			{publicaciones.map((p) => (
				<article class="pub-card">
					{p.imagen ? (
						<div class="pub-cover pub-cover-img">
							<img src={p.imagen} alt={p.titulo} loading="lazy" />
						</div>
					) : (
						<div class="pub-cover" aria-hidden="true">📘</div>
					)}
					<div class="pub-body">
						<span class="pub-tipo">{p.tipo} · {p.anio}</span>
						<h3>{p.titulo}</h3>
						{p.descripcion && <p class="pub-desc">{p.descripcion}</p>}
					</div>
				</article>
			))}
		</div>
	</section>

	<section id="servicios-editoriales">
		<span class="eyebrow">Servicios editoriales</span>
		<h2>Servicios Editoriales</h2>
		<p>
			Te acompañamos en la publicación de obras y materiales, ya sea como autor único o
			como autor institucional.
		</p>
		<p>
			Nuestros servicios incluyen el asesoramiento, corrección, edición, diagramación,
			registro en organismos oficiales, trámite de reconocimiento de propiedad intelectual
			(derecho de autor), impresión en pequeñas y grandes tiradas, publicidad, difusión y
			distribución.
		</p>
		<p>Tenemos propuestas especiales para instituciones educativas, no dudes en consultarnos.</p>
		<a
			href="https://wa.me/5493516315102?text=Quiero+informaci%C3%B3n+sobre+los+SERVICIOS+EDITORIALES&utm_source=chatgpt.com"
			class="btn btn-teal btn-whatsapp"
			target="_blank"
			rel="noopener noreferrer"
		>
			<Icon name="whatsapp" />
			Quiero más información
		</a>
	</section>

	<section id="convertite-en-autor">
		<span class="eyebrow">Convocatoria</span>
		<h2>¡Convertite en autor de una obra colaborativa!</h2>
		<p>
			En la Fundación Freinet promovemos la escritura colaborativa como vía privilegiada
			para difundir las ideas y proyectos de los docentes y directivos.
		</p>
		<h3>¿Cómo funciona?</h3>
		<ol class="steps-list">
			<li>
				<span class="step-icon" aria-hidden="true">✍️</span>
				<span><strong>Proponés tu aporte:</strong> presentás una experiencia, reflexión, artículo o producción vinculada con la temática de la obra.</span>
			</li>
			<li>
				<span class="step-icon" aria-hidden="true">📖</span>
				<span><strong>Evaluamos y acompañamos:</strong> el equipo editorial revisa el material y brinda orientaciones para su adecuación y edición.</span>
			</li>
			<li>
				<span class="step-icon" aria-hidden="true">🤝</span>
				<span><strong>Construimos colectivamente:</strong> tu aporte se integra junto con el de otros autores en una obra común.</span>
			</li>
			<li>
				<span class="step-icon" aria-hidden="true">🎨</span>
				<span><strong>Editamos y publicamos:</strong> Fundación Freinet realiza la edición, diseño y preparación de la obra para su publicación.</span>
			</li>
			<li>
				<span class="step-icon" aria-hidden="true">🌎</span>
				<span><strong>Compartimos saberes:</strong> la obra final permite visibilizar y poner en circulación experiencias y conocimientos construidos desde el campo educativo.</span>
			</li>
		</ol>
		<p>
			Una oportunidad para escribir, compartir y formar parte de una producción colectiva
			que deja huella en la educación.
		</p>
		<p>Te invitamos a sumarte a nuestra convocatoria vigente para Setiembre-Octubre.</p>
		<div class="cta-group">
			<a href="https://forms.gle/X7m2KXs4AiJBQQxK8" class="btn btn-teal" target="_blank" rel="noopener noreferrer">¡Quiero sumarme!</a>
			<a
				href="https://wa.me/5493516315102?text=QUIERO+INFORMACION+SOBRE+LA+PUBLICACION+COLABORATIVA&utm_source=chatgpt.com"
				class="btn btn-outline-teal btn-whatsapp"
				target="_blank"
				rel="noopener noreferrer"
			>
				<Icon name="whatsapp" />
				Contactanos
			</a>
		</div>
	</section>
</SectionLayout>

<style>
	.editorial-intro p {
		max-width: 70ch;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--ink-700, #334155);
		margin: 0 0 16px;
	}

	.editorial-intro p:last-child {
		margin-bottom: 0;
	}

	.pub-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
		margin-top: 20px;
	}

	.pub-card {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--cream);
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	.pub-card:hover {
		box-shadow: 0 10px 24px rgba(15, 23, 42, 0.1);
		transform: translateY(-2px);
	}

	.pub-cover {
		background: var(--teal-800);
		color: #fff;
		font-size: 2rem;
		aspect-ratio: 2 / 3;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.pub-cover-img {
		padding: 0;
	}

	.pub-cover-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.pub-body {
		padding: 18px 20px 22px;
	}

	.pub-tipo {
		display: inline-block;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--teal-700);
		background: var(--teal-50);
		border-radius: 999px;
		padding: 4px 10px;
		font-weight: 700;
	}

	.pub-card h3 {
		font-size: 1.05rem;
		line-height: 1.35;
		color: var(--teal-900);
		margin: 12px 0 0;
	}

	.pub-desc {
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--ink-600, #475569);
		margin: 8px 0 0;
	}

	#servicios-editoriales > p,
	#convertite-en-autor > p {
		max-width: 70ch;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--ink-700, #334155);
		margin: 0 0 14px;
	}

	#convertite-en-autor h3 {
		margin: 24px 0 12px;
	}

	.steps-list {
		list-style: none;
		margin: 0 0 20px;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.steps-list li {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		max-width: 70ch;
	}

	.step-icon {
		font-size: 1.2rem;
		line-height: 1.5;
	}

	.steps-list li span:last-child {
		line-height: 1.6;
		color: var(--ink-700, #334155);
	}

	.cta-group {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 8px;
	}

	.btn-whatsapp {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	@media (max-width: 700px) {
		.pub-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
