---
import SectionLayout from "../layouts/SectionLayout.astro";
import Icon from "../components/Icon.astro";

const base = import.meta.env.BASE_URL;

const navItems = [
	{ id: "noticias", label: "Noticias" },
	{ id: "redes-sociales", label: "Redes sociales" },
	{ id: "proximas-convocatorias", label: "Próximas convocatorias" },
];

const noticias = [
	{
		tag: "Institucional",
		theme: "teal",
		title: "Celebramos el 70° aniversario del Instituto Católico Superior",
		excerpt:
			"Con una Misa presidida por S.E.R. cardenal Ángel Sixto Rossi; también, con un Acto Académico que contó con la presencia de la Dra. Gabriela Peña, Representante Legal de la institución, directivos, profesores, ex profesores, estudiantes, familias y amigos.",
		fecha: "Septiembre de 2026",
		images: [
			base + "images/noticias/70-aniversario-misa.webp",
			base + "images/noticias/70-aniversario-acto-academico.webp",
			base + "images/noticias/70-aniversario-placa.png",
		],
	},
	{
		tag: "Formación",
		theme: "coral",
		title:
			"Finalizamos nuestro curso “Gestión Directiva: Inclusión y Convivencia desde el Enfoque del Bienestar Educativo”",
		excerpt:
			"Superamos los inscriptos del curso anterior y nos proyectamos a seguir creciendo en el último trimestre del año.",
		fecha: "Septiembre de 2026",
		images: [
			base + "images/noticias/gestion-directiva-equipo.png",
			base + "images/noticias/gestion-directiva-cierre.png",
		],
	},
	{
		tag: "Asesoramiento",
		theme: "mustard",
		title: "Presentamos nuevos servicios y programas para acompañarte en tu tarea cotidiana",
		excerpt:
			"Para docentes y directivos de escuelas cordobesas. Ingresá en esta sección para no perderte detalle de estas iniciativas.",
		fecha: "Septiembre de 2026",
		href: base + "asesoramiento",
	},
	{
		tag: "Editorial",
		theme: "deep",
		title: "Ampliamos la inscripción para la segunda publicación colaborativa del 2026",
		excerpt:
			"Ingresá en esta sección para formar parte de esta iniciativa que, además, te permite sumar puntaje por publicación (*). (*) Conforme al criterio y normativa vigente de cada Junta de Clasificación de la Provincia de Córdoba.",
		fecha: "Septiembre de 2026",
		href: base + "editorial",
	},
];

const convocatorias = [
	{
		fecha: "Sáb. 3/10",
		titulo:
			"Evaluación Final – Curso de Gestión Directiva: Inclusión y Convivencia desde el Enfoque del Bienestar Educativo",
	},
	{
		fecha: "Jue. 7/10",
		titulo:
			"1er Encuentro Sincrónico de la Preparación para rendir Concursos Directivos en la Provincia de Córdoba",
	},
	{ fecha: "Mar. 15/10", titulo: "Webinario de Legislación y Normativa Escolar por Meet" },
];

---

<SectionLayout
	title="Novedades — Fundación Freinet"
	description="Noticias, redes sociales y próximas convocatorias de la Fundación Freinet."
	eyebrow="Novedades"
	heroDescription="Enterate de todas las novedades relacionadas con la vida de la Fundación en la Comunidad Educativa Cordobesa. Seguinos en nuestras redes y no te pierdas detalle de todo lo que hacemos."
	theme="teal"
	navItems={navItems}
>
	<section id="noticias">
		<span class="eyebrow">Noticias</span>
		<h2>Últimas publicaciones</h2>
		<div class="news-list">
			{noticias.map((n) => (
				<article class="news-item">
					<div class:list={["news-tag-wrap", `theme-${n.theme}`]}>
						<span>{n.tag}</span>
					</div>
					<div class="news-content">
						<span class="news-date">{n.fecha}</span>
						<h3>{n.href ? <a href={n.href}>{n.title}</a> : n.title}</h3>
						<p>{n.excerpt}</p>
						{n.href && (
							<a href={n.href} class="news-link">Ver más ›</a>
						)}
						{n.images && (
							<div class="news-gallery">
								{n.images.map((src) => (
									<img src={src} alt={n.title} loading="lazy" />
								))}
							</div>
						)}
					</div>
				</article>
			))}
		</div>
	</section>

	<section id="redes-sociales">
		<span class="eyebrow">Redes sociales</span>
		<h2>Seguinos en Facebook e Instagram</h2>
		<p>
			Compartimos a diario recursos, testimonios y convocatorias junto a la comunidad de
			educadores que nos acompaña.
		</p>
		<div class="social-stats">
			<a
				class="social-card theme-facebook"
				href="https://www.facebook.com/fundacionfreinet"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="social-icon"><Icon name="facebook" /></span>
				<span class="social-info">
					<strong>844+</strong>
					<span>Seguidores en Facebook</span>
				</span>
			</a>
			<a
				class="social-card theme-instagram"
				href="https://www.instagram.com/fundacionfreinet"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="social-icon"><Icon name="instagram" /></span>
				<span class="social-info">
					<strong>5.700+</strong>
					<span>Seguidores en Instagram</span>
				</span>
			</a>
		</div>
	</section>

	<section id="proximas-convocatorias">
		<span class="eyebrow">Próximas convocatorias</span>
		<h2>Agenda</h2>
		<ul class="agenda-list">
			{convocatorias.map((c) => (
				<li>
					<span class="agenda-fecha">{c.fecha}</span>
					<span>{c.titulo}</span>
				</li>
			))}
		</ul>
	</section>
</SectionLayout>

<style>
	.news-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin-top: 20px;
	}

	.news-item {
		display: grid;
		grid-template-columns: 130px 1fr;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.news-tag-wrap {
		display: flex;
		align-items: flex-start;
		padding: 18px;
		color: #fff;
	}

	.news-tag-wrap span {
		background: rgba(255, 255, 255, 0.2);
		padding: 4px 10px;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.theme-teal { background: var(--teal-800); }
	.theme-coral { background: var(--coral-dark); }
	.theme-mustard { background: var(--mustard); }
	.theme-deep { background: var(--deep); }

	.news-content {
		padding: 18px 20px;
	}

	.news-date {
		font-size: 0.78rem;
		color: var(--teal-700);
		font-weight: 700;
	}

	.news-content h3 {
		font-size: 1rem;
		margin: 6px 0;
	}

	.news-content p {
		margin: 0;
		font-size: 0.9rem;
	}

	.news-content h3 a {
		color: inherit;
		text-decoration: none;
	}

	.news-content h3 a:hover {
		color: var(--coral);
	}

	.news-link {
		display: inline-block;
		margin-top: 10px;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--teal-700);
		text-decoration: none;
	}

	.news-link:hover {
		color: var(--coral);
	}

	.news-gallery {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 10px;
		margin-top: 14px;
	}

	.news-gallery img {
		width: 100%;
		height: 130px;
		object-fit: contain;
		background: var(--teal-50);
		border-radius: var(--radius);
		border: 1px solid var(--border);
	}

	.social-stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		max-width: 460px;
		margin-top: 20px;
	}

	.social-card {
		display: flex;
		align-items: center;
		gap: 16px;
		background: var(--teal-50);
		border: 1px solid var(--teal-100);
		border-radius: var(--radius);
		padding: 20px 22px;
		text-decoration: none;
		transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
	}

	.social-card:hover {
		box-shadow: 0 10px 24px rgba(15, 23, 42, 0.1);
		transform: translateY(-2px);
	}

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 46px;
		height: 46px;
		flex-shrink: 0;
		border-radius: 50%;
		color: #fff;
	}

	.social-icon :global(svg) {
		width: 22px;
		height: 22px;
	}

	.theme-facebook .social-icon { background: #1877f2; }
	.theme-facebook:hover { border-color: #1877f2; }

	.theme-instagram .social-icon {
		background: radial-gradient(circle at 30% 110%, #fdf497 0%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
	}
	.theme-instagram:hover { border-color: #d6249f; }

	.social-info {
		display: flex;
		flex-direction: column;
	}

	.social-info strong {
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1.4rem;
		color: var(--teal-800);
	}

	.social-info span {
		font-size: 0.82rem;
		color: var(--ink-soft);
	}

	.agenda-list {
		list-style: none;
		margin: 20px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.agenda-list li {
		display: flex;
		gap: 16px;
		padding: 14px 16px;
		background: var(--teal-50);
		border-radius: var(--radius);
	}

	.agenda-fecha {
		font-weight: 700;
		color: var(--teal-800);
		min-width: 90px;
	}

	@media (max-width: 560px) {
		.news-item {
			grid-template-columns: 1fr;
		}
		.social-stats {
			grid-template-columns: 1fr;
		}
		.news-gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
