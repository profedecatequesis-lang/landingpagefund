---
const base = import.meta.env.BASE_URL;
const schedule = [
	{ date: "Sáb. 8/08", time: "8:00 a 15:30 hs" },
	{ date: "Sáb. 22/08", time: "8:00 a 15:30 hs" },
	{ date: "Sáb. 5/09", time: "8:00 a 15:30 hs" },
	{ date: "Sáb. 19/09", time: "8:00 a 15:30 hs" },
];
---

<section id="formacion" class="featured">
	<div class="container featured-grid">
		<div class="featured-flyer">
			<span class="flyer-tag">Oferente 733-0-4</span>
			<h3>Curso</h3>
			<h2>Gestión Directiva: Inclusión y Convivencia desde el Enfoque de Bienestar Educativo</h2>

			<div class="flyer-badges">
				<div class="badge">
					<strong>50 horas</strong>
					<span>Acredita — Resolución del Ministerio de Educación de Córdoba</span>
				</div>
				<div class="badge protocolo">
					<strong>Protocolo</strong>
					<span>2026/SDFP 00000797</span>
				</div>
			</div>

			<p class="flyer-note">
				Acompañados por las capacitadoras de Fundación Senda Azul · Modalidad semipresencial
				asincrónica
			</p>
		</div>

		<div class="featured-details">
			<h3 class="details-title">Cronograma presencial</h3>
			<ul class="schedule-list">
				{schedule.map((s) => (
					<li>
						<span class="schedule-date">{s.date}</span>
						<span class="schedule-time">{s.time}</span>
					</li>
				))}
				<li class="schedule-eval">
					<span class="schedule-date">Evaluación · 3/10</span>
					<span class="schedule-time">9:00 a 12:00 hs</span>
				</li>
			</ul>

			<h3 class="details-title">Opciones de pago</h3>
			<div class="payment-options">
				<span>💵 Contado con descuento</span>
				<span>💳 Cuotas autofinanciadas</span>
				<span>📱 Más cuotas con Mercado Pago</span>
			</div>

			<a href={base + "contacto"} class="btn btn-primary">Inscribirme por WhatsApp</a>
		</div>
	</div>
</section>

<style>
	.featured {
		background: var(--cream);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 40px;
	}

	.featured-flyer {
		background: var(--coral-dark);
		color: #fff;
		border-radius: var(--radius);
		padding: 36px;
		position: relative;
	}

	.flyer-tag {
		display: inline-block;
		background: rgba(255, 255, 255, 0.18);
		padding: 5px 14px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		margin-bottom: 16px;
	}

	.featured-flyer h3 {
		color: #ffd9e2;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 6px;
	}

	.featured-flyer h2 {
		color: #fff;
		font-size: 1.5rem;
		margin-bottom: 24px;
	}

	.flyer-badges {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 20px;
	}

	.badge {
		background: rgba(255, 255, 255, 0.14);
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: var(--radius);
		padding: 12px 16px;
	}

	.badge strong {
		display: block;
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1.1rem;
	}

	.badge span {
		font-size: 0.82rem;
		color: #ffe3ea;
	}

	.badge.protocolo strong {
		font-size: 0.95rem;
	}

	.flyer-note {
		color: #ffe3ea;
		font-size: 0.86rem;
		margin: 0;
	}

	.featured-details {
		background: #fff;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 36px;
	}

	.details-title {
		font-size: 1rem;
		font-family: var(--font-sans);
		font-weight: 700;
		color: var(--teal-900);
		margin-bottom: 12px;
	}

	.schedule-list {
		list-style: none;
		margin: 0 0 28px;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.schedule-list li {
		display: flex;
		justify-content: space-between;
		padding: 10px 14px;
		background: var(--teal-50);
		border-radius: var(--radius);
		font-size: 0.9rem;
	}

	.schedule-date {
		font-weight: 700;
		color: var(--teal-800);
	}

	.schedule-time {
		color: var(--ink-soft);
	}

	.schedule-eval {
		background: #fdeaea;
	}

	.payment-options {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 28px;
		font-size: 0.92rem;
		color: var(--ink-soft);
	}

	@media (max-width: 900px) {
		.featured-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
