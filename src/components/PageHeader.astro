---
const base = import.meta.env.BASE_URL;
interface Props {
	eyebrow: string;
	title: string;
	description: string;
	theme?: "teal" | "coral" | "mustard" | "deep";
}

const { eyebrow, title, description, theme = "teal" } = Astro.props;
---

<section class:list={["page-header", `theme-${theme}`]}>
	<div class="container">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href={base}>Inicio</a>
			<span>/</span>
			<span>{eyebrow}</span>
		</nav>
		<h1>{title}</h1>
		<p>{description}</p>
	</div>
</section>

<style>
	.page-header {
		padding: 48px 0 56px;
		color: #fff;
	}

	.theme-teal { background: var(--teal-800); }
	.theme-coral { background: var(--coral-dark); }
	.theme-mustard { background: var(--mustard); }
	.theme-deep { background: var(--deep); }

	.breadcrumb {
		display: flex;
		gap: 8px;
		font-size: 0.82rem;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: 18px;
	}

	.breadcrumb a {
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: #fff;
	}

	.page-header h1 {
		color: #fff;
		font-size: clamp(1.8rem, 3.2vw, 2.5rem);
		max-width: 26ch;
	}

	.page-header p {
		color: rgba(255, 255, 255, 0.88);
		max-width: 62ch;
		font-size: 1.03rem;
		margin: 0;
	}
</style>
