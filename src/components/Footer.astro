---
const base = import.meta.env.BASE_URL;
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const columns = [
	{
		title: "Institucional",
		links: [
			{ label: "Quiénes somos", href: base + "institucional#quienes-somos" },
			{ label: "Autoridades", href: base + "institucional#autoridades" },
			{ label: "Alianzas y convenios", href: base + "institucional#alianzas-y-convenios" },
		],
	},
	{
		title: "Formación",
		links: [
			{ label: "Cursos con puntaje", href: base + "formacion#cursos-con-puntaje" },
			{ label: "Programa destacado", href: base + "formacion#gestion-directiva" },
			{ label: "Webinarios", href: base + "formacion#webinarios" },
			{ label: "Cursos ya dictados", href: base + "formacion#cursos-ya-dictados" },
		],
	},
	{
		title: "Asesoramiento",
		links: [
			{ label: "Servicio de Consultoría", href: base + "asesoramiento#servicio-de-consultoria" },
			{ label: "Acompañamiento a la Función Directiva", href: base + "asesoramiento#acompanamiento-funcion-directiva" },
			{ label: "Asesoramiento Institucional", href: base + "asesoramiento#asesoramiento-institucional" },
			{ label: "Conferencias en Escuelas", href: base + "asesoramiento#conferencias-en-escuelas" },
		],
	},
	{
		title: "Editorial",
		links: [
			{ label: "Publicaciones", href: base + "editorial#publicaciones" },
			{ label: "Servicios editoriales", href: base + "editorial#servicios-editoriales" },
			{ label: "¡Convertite en autor de una obra colaborativa!", href: base + "editorial#convertite-en-autor" },
		],
	},
	{
		title: "Novedades",
		links: [
			{ label: "Noticias", href: base + "novedades#noticias" },
			{ label: "Redes sociales", href: base + "novedades#redes-sociales" },
			{ label: "Próximas convocatorias", href: base + "novedades#proximas-convocatorias" },
		],
	},
	{
		title: "Consultas",
		links: [
			{ label: "Contacto", href: base + "contacto" },
		],
	},
];
---

<footer id="contacto" class="site-footer">
	<div class="container footer-columns">
		{columns.map((col) => (
			<div class="footer-col">
				<h4>{col.title}</h4>
				<ul>
					{col.links.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>
		))}
	</div>

	<div class="footer-divider container"></div>

	<div class="container footer-bottom">
		<div class="footer-social">
			<a href="https://www.facebook.com/fundacionfreinet" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><Icon name="facebook" /></a>
			<a href="https://www.instagram.com/fundacionfreinet" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><Icon name="instagram" /></a>
			<a href="https://wa.me/5493516315102" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /></a>
			<a href="mailto:fundacionfreinetcba@gmail.com" aria-label="Enviar email"><Icon name="mail" /></a>
		</div>

		<div class="footer-org">
			<strong>Fundación Freinet</strong>
			<span>Pers. Jur. n.º 338C/21 · Oferente 733-0 SPFDC</span>
			<span>© {year} Fundación Freinet</span>
		</div>

		<div class="footer-address">
			<span>Ciudad de Córdoba</span>
			<span>Córdoba, Argentina</span>
			<span>0351 15-631-5102</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--cream);
		border-top: 1px solid var(--border);
		padding-top: 48px;
	}

	.footer-columns {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 24px;
		padding-bottom: 36px;
	}

	.footer-col h4 {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--teal-900);
		margin-bottom: 14px;
	}

	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 9px;
	}

	.footer-col a {
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.86rem;
	}

	.footer-col a:hover {
		color: var(--teal-700);
	}

	.footer-divider {
		border-top: 1px solid var(--border);
	}

	.footer-bottom {
		display: grid;
		grid-template-columns: auto 1fr 1fr 1.4fr;
		gap: 24px;
		align-items: start;
		padding: 28px 24px 32px;
		font-size: 0.82rem;
		color: var(--ink-soft);
	}

	.footer-social {
		display: flex;
		gap: 10px;
	}

	.footer-social a {
		width: 34px;
		height: 34px;
		border-radius: var(--radius);
		background: #fff;
		border: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		color: var(--teal-800);
	}

	.footer-social a:hover {
		background: var(--teal-800);
		color: #fff;
		border-color: var(--teal-800);
	}

	.footer-org,
	.footer-address {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.footer-org strong {
		color: var(--teal-900);
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1rem;
	}

	.footer-legal {
		font-style: italic;
		line-height: 1.5;
		max-width: 42ch;
	}

	@media (max-width: 1000px) {
		.footer-columns {
			grid-template-columns: repeat(3, 1fr);
		}
		.footer-bottom {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 620px) {
		.footer-columns {
			grid-template-columns: repeat(2, 1fr);
		}
		.footer-bottom {
			grid-template-columns: 1fr;
		}
	}
</style>
