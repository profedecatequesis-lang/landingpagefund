---
const base = import.meta.env.BASE_URL;
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const columns = [
	{
		title: "Perfiles",
		links: [
			{ label: "Docentes", href: base + "formacion" },
			{ label: "Equipos directivos", href: base + "asesoramiento#a-equipos-directivos" },
			{ label: "Instituciones", href: base + "asesoramiento#a-instituciones" },
			{ label: "Familias", href: base + "novedades" },
			{ label: "Prensa", href: base + "novedades#noticias" },
		],
	},
	{
		title: "Institucional",
		links: [
			{ label: "Quiénes somos", href: base + "institucional#quienes-somos" },
			{ label: "Autoridades", href: base + "institucional#autoridades" },
			{ label: "Historia", href: base + "institucional#historia" },
			{ label: "Alianzas y convenios", href: base + "institucional#alianzas-y-convenios" },
			{ label: "Memoria institucional", href: base + "institucional#memoria-institucional" },
		],
	},
	{
		title: "Formación",
		links: [
			{ label: "Cursos con puntaje", href: base + "formacion#cursos-con-puntaje" },
			{ label: "Gestión directiva", href: base + "formacion#gestion-directiva" },
			{ label: "Seminarios", href: base + "formacion#seminarios" },
			{ label: "Certificaciones", href: base + "formacion#certificaciones" },
			{ label: "Calendario de cursada", href: base + "formacion#calendario-de-cursada" },
		],
	},
	{
		title: "Asesoramiento",
		links: [
			{ label: "A instituciones", href: base + "asesoramiento#a-instituciones" },
			{ label: "Convivencia escolar", href: base + "asesoramiento#convivencia-escolar" },
			{ label: "Bienestar educativo", href: base + "asesoramiento#bienestar-educativo" },
			{ label: "A equipos directivos", href: base + "asesoramiento#a-equipos-directivos" },
		],
	},
	{
		title: "Novedades",
		links: [
			{ label: "Noticias", href: base + "novedades#noticias" },
			{ label: "Redes sociales", href: base + "novedades#redes-sociales" },
			{ label: "Próximas convocatorias", href: base + "novedades#proximas-convocatorias" },
		],
	},
	{
		title: "Consultas",
		links: [
			{ label: "Contacto", href: base + "contacto" },
			{ label: "Cómo llegar", href: base + "contacto#como-llegar" },
			{ label: "Formas de pago", href: base + "contacto#formas-de-pago" },
			{ label: "Preguntas frecuentes", href: base + "contacto#preguntas-frecuentes" },
		],
	},
];
---

<footer id="contacto" class="site-footer">
	<div class="container footer-columns">
		{columns.map((col) => (
			<div class="footer-col">
				<h4>{col.title}</h4>
				<ul>
					{col.links.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>
		))}
	</div>

	<div class="footer-divider container"></div>

	<div class="container footer-bottom">
		<div class="footer-social">
			<a href="#" aria-label="Facebook"><Icon name="facebook" /></a>
			<a href="#" aria-label="Instagram"><Icon name="instagram" /></a>
			<a href="#" aria-label="WhatsApp"><Icon name="whatsapp" /></a>
			<a href="#" aria-label="YouTube"><Icon name="youtube" /></a>
		</div>

		<div class="footer-org">
			<strong>Fundación Freinet</strong>
			<span>Pers. Jur. n.º 338C/21 · Oferente RPFDC 733-0</span>
			<span>© {year} Fundación Freinet</span>
		</div>

		<div class="footer-address">
			<span>Ciudad de Córdoba</span>
			<span>Córdoba, Argentina</span>
			<span>0351 15-631-5102</span>
		</div>

		<div class="footer-legal">
			Toda la información y los contenidos publicados en este sitio tienen fines
			informativos y no reemplazan la comunicación directa con la Fundación. Los datos de
			contacto y cursos son de ejemplo y deben confirmarse con la institución.
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--cream);
		border-top: 1px solid var(--border);
		padding-top: 48px;
	}

	.footer-columns {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 24px;
		padding-bottom: 36px;
	}

	.footer-col h4 {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--teal-900);
		margin-bottom: 14px;
	}

	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 9px;
	}

	.footer-col a {
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.86rem;
	}

	.footer-col a:hover {
		color: var(--teal-700);
	}

	.footer-divider {
		border-top: 1px solid var(--border);
	}

	.footer-bottom {
		display: grid;
		grid-template-columns: auto 1fr 1fr 1.4fr;
		gap: 24px;
		align-items: start;
		padding: 28px 24px 32px;
		font-size: 0.82rem;
		color: var(--ink-soft);
	}

	.footer-social {
		display: flex;
		gap: 10px;
	}

	.footer-social a {
		width: 34px;
		height: 34px;
		border-radius: var(--radius);
		background: #fff;
		border: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		color: var(--teal-800);
	}

	.footer-social a:hover {
		background: var(--teal-800);
		color: #fff;
		border-color: var(--teal-800);
	}

	.footer-org,
	.footer-address {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.footer-org strong {
		color: var(--teal-900);
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1rem;
	}

	.footer-legal {
		font-style: italic;
		line-height: 1.5;
		max-width: 42ch;
	}

	@media (max-width: 1000px) {
		.footer-columns {
			grid-template-columns: repeat(3, 1fr);
		}
		.footer-bottom {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 620px) {
		.footer-columns {
			grid-template-columns: repeat(2, 1fr);
		}
		.footer-bottom {
			grid-template-columns: 1fr;
		}
	}
</style>
