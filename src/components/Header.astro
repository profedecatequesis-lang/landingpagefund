---
const base = import.meta.env.BASE_URL;
const navLinks = [
	{
		label: "Institucional",
		href: base + "institucional",
		children: [
			{ label: "Quiénes somos", href: base + "institucional#quienes-somos" },
			{ label: "Autoridades", href: base + "institucional#autoridades" },
			// { label: "Historia", href: base + "institucional#historia" }, // oculto por el momento
			{ label: "Alianzas y convenios", href: base + "institucional#alianzas-y-convenios" },
			// { label: "Memoria institucional", href: base + "institucional#memoria-institucional" }, // oculto por el momento
		],
	},
	{
		label: "Formación",
		href: base + "formacion",
		children: [
			{ label: "Cursos con puntaje", href: base + "formacion#cursos-con-puntaje" },
			{ label: "Programa destacado", href: base + "formacion#gestion-directiva" },
			// { label: "Seminarios", href: base + "formacion#seminarios" }, // oculto por el momento
			{ label: "Webinarios", href: base + "formacion#webinarios" },
			// { label: "Calendario de cursada", href: base + "formacion#calendario-de-cursada" }, // oculto por el momento
			// { label: "Certificaciones", href: base + "formacion#certificaciones" }, // oculto por el momento
		],
	},
	{
		label: "Asesoramiento",
		href: base + "asesoramiento",
		children: [
			{ label: "Servicio de Consultoría", href: base + "asesoramiento#servicio-de-consultoria" },
			{ label: "Acompañamiento a la Función Directiva", href: base + "asesoramiento#acompanamiento-funcion-directiva" },
			{ label: "Asesoramiento Institucional", href: base + "asesoramiento#asesoramiento-institucional" },
			{ label: "Conferencias en Escuelas", href: base + "asesoramiento#conferencias-en-escuelas" },
		],
	},
	{
		label: "Editorial",
		href: base + "editorial",
		children: [
			{ label: "Publicaciones", href: base + "editorial#publicaciones" },
			{ label: "Servicios editoriales", href: base + "editorial#servicios-editoriales" },
			{ label: "¡Convertite en autor de una obra colaborativa!", href: base + "editorial#convertite-en-autor" },
		],
	},
	{
		label: "Novedades",
		href: base + "novedades",
		children: [
			{ label: "Noticias", href: base + "novedades#noticias" },
			{ label: "Redes sociales", href: base + "novedades#redes-sociales" },
			{ label: "Próximas convocatorias", href: base + "novedades#proximas-convocatorias" },
		],
	},
];
---

<header class="site-header">
	<div class="topbar">
		<div class="container topbar-inner">
			<a href={base} class="brand">
				<img src={base + "images/logo-ff.png"} alt="Fundación Freinet" class="brand-mark" />
				<span class="brand-text">
					<strong>Fundación Freinet</strong>
					<small>Pers. Jur. n.º 338C/21 · Oferente 733-0 SPFDC</small>
				</span>
			</a>

			<div class="topbar-links">
				<a href={base + "novedades#noticias"}>Noticias</a>
				<a href={base + "novedades#proximas-convocatorias"}>Calendario</a>
				<a href={base + "editorial#publicaciones"}>Publicaciones</a>
				<a href={base + "formacion#cursos-con-puntaje"}>Cursos</a>
				<a href={base + "contacto"}>Consultas</a>
				<a href="https://cursosfreinet.moodlecloud.com" class="topbar-highlight" target="_blank" rel="noopener noreferrer">Campus Virtual</a>
			</div>
		</div>
	</div>

	<div class="navbar">
		<div class="container navbar-inner">
			<button
				type="button"
				class="nav-toggle"
				id="navToggle"
				aria-expanded="false"
				aria-controls="mobileNavPanel"
				aria-label="Abrir menú de navegación"
			>
				<span class="nav-toggle-bar"></span>
				<span class="nav-toggle-bar"></span>
				<span class="nav-toggle-bar"></span>
			</button>

			<div class="nav-panel" id="mobileNavPanel">
				<nav class="mainnav" aria-label="Navegación principal">
					<ul>
						{navLinks.map((link, i) => (
							<li class="has-dropdown">
								<div class="nav-item-row">
									<a href={link.href}>{link.label}</a>
									<button
										type="button"
										class="dropdown-toggle"
										aria-expanded="false"
										aria-controls={`dropdown-${i}`}
										aria-label={`Mostrar submenú de ${link.label}`}
									>
										<span class="chevron-icon" aria-hidden="true">▾</span>
									</button>
								</div>
								<div class="dropdown" id={`dropdown-${i}`}>
									<ul>
										{link.children.map((child) => (
											<li><a href={child.href}>{child.label}</a></li>
										))}
									</ul>
								</div>
							</li>
						))}
					</ul>
				</nav>

				<form class="searchbox" role="search" onsubmit="return false;">
					<input type="text" placeholder="Escribir texto a buscar..." aria-label="Buscar" />
					<button type="submit" aria-label="Buscar">🔍</button>
				</form>
			</div>
		</div>
	</div>
</header>

<script>
	const navToggle = document.getElementById("navToggle");
	const navPanel = document.getElementById("mobileNavPanel");

	function closePanel() {
		navToggle?.classList.remove("is-open");
		navToggle?.setAttribute("aria-expanded", "false");
		navPanel?.classList.remove("is-open");
	}

	function togglePanel() {
		const isOpen = navPanel?.classList.toggle("is-open") ?? false;
		navToggle?.classList.toggle("is-open", isOpen);
		navToggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
	}

	navToggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		togglePanel();
	});

	const dropdownToggles = Array.from(document.querySelectorAll<HTMLElement>(".dropdown-toggle"));
	dropdownToggles.forEach((btn) => {
		btn.addEventListener("click", () => {
			const li = btn.closest(".has-dropdown");
			const dropdown = document.getElementById(btn.getAttribute("aria-controls") ?? "");
			const isExpanded = li?.classList.toggle("is-expanded") ?? false;
			btn.setAttribute("aria-expanded", isExpanded ? "true" : "false");
			if (dropdown instanceof HTMLElement) {
				dropdown.style.maxHeight = isExpanded ? dropdown.scrollHeight + "px" : "";
				if (isExpanded) {
					dropdown.removeAttribute("inert");
				} else {
					dropdown.setAttribute("inert", "");
				}
			}
		});
	});

	const panelLinks = Array.from(navPanel?.querySelectorAll<HTMLAnchorElement>("a") ?? []);
	panelLinks.forEach((link) => {
		link.addEventListener("click", () => {
			closePanel();
		});
	});

	document.addEventListener("click", (e) => {
		if (!navPanel?.classList.contains("is-open")) return;
		const target = e.target as Node;
		if (navPanel.contains(target) || navToggle?.contains(target)) return;
		closePanel();
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			closePanel();
			navToggle?.focus();
		}
	});

	window.addEventListener("resize", () => {
		if (window.innerWidth > 900) {
			closePanel();
			document.querySelectorAll<HTMLElement>(".has-dropdown.is-expanded").forEach((li) => {
				li.classList.remove("is-expanded");
				const dropdown = li.querySelector<HTMLElement>(".dropdown");
				if (dropdown) {
					dropdown.style.maxHeight = "";
					dropdown.setAttribute("inert", "");
				}
				const toggle = li.querySelector<HTMLElement>(".dropdown-toggle");
				toggle?.setAttribute("aria-expanded", "false");
			});
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.topbar {
		background: #fff;
		border-bottom: 1px solid var(--border);
	}

	.topbar-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		padding: 12px 24px;
		flex-wrap: wrap;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		flex-shrink: 0;
	}

	.brand-mark {
		width: 44px;
		height: 44px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}

	.brand-text strong {
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1.1rem;
		color: var(--teal-900);
	}

	.brand-text small {
		color: var(--ink-soft);
		font-size: 0.68rem;
	}

	.topbar-links {
		display: flex;
		align-items: center;
		gap: 18px;
		flex-wrap: wrap;
		font-size: 0.85rem;
		font-weight: 600;
	}

	.topbar-links a {
		text-decoration: none;
		color: var(--ink-soft);
	}

	.topbar-links a:hover {
		color: var(--teal-800);
	}

	.topbar-highlight {
		background: var(--teal-700);
		color: #fff !important;
		padding: 8px 16px;
		border-radius: 2px;
	}

	.topbar-highlight:hover {
		background: var(--teal-900);
		color: #fff !important;
	}

	.navbar {
		background: var(--teal-900);
	}

	.navbar-inner {
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		gap: 20px;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		background: rgba(255, 255, 255, 0.12);
		border: none;
		border-radius: 2px;
		cursor: pointer;
		padding: 0;
		flex-shrink: 0;
		align-self: center;
		margin: 10px 0;
	}

	.nav-toggle-bar {
		display: block;
		width: 20px;
		height: 2px;
		background: #fff;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.nav-toggle.is-open .nav-toggle-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.nav-toggle.is-open .nav-toggle-bar:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle.is-open .nav-toggle-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.nav-panel {
		display: contents;
	}

	.mainnav ul {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.has-dropdown {
		position: relative;
	}

	.nav-item-row {
		display: contents;
	}

	.dropdown-toggle {
		display: none;
	}

	.mainnav > ul > li > .nav-item-row > a {
		display: block;
		padding: 16px 20px;
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: #fff;
	}

	.has-dropdown:hover .nav-item-row > a,
	.has-dropdown:focus-within .nav-item-row > a {
		background: var(--teal-700);
	}

	.dropdown {
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 230px;
		background: #fff;
		border: 1px solid var(--border);
		border-top: 3px solid var(--teal-700);
		box-shadow: var(--shadow);
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
		transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
		z-index: 60;
	}

	.has-dropdown:hover .dropdown,
	.has-dropdown:focus-within .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.dropdown ul {
		flex-direction: column;
		padding: 8px 0;
	}

	.dropdown a {
		display: block;
		padding: 10px 20px;
		font-size: 0.86rem;
		font-weight: 600;
		text-transform: none;
		letter-spacing: normal;
		color: var(--ink);
		text-decoration: none;
	}

	.dropdown a:hover {
		background: var(--teal-50);
		color: var(--teal-800);
	}

	.searchbox {
		display: flex;
		align-items: center;
		gap: 6px;
		align-self: center;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 2px;
		padding: 6px 6px 6px 16px;
		margin: 10px 0;
	}

	.searchbox input {
		background: transparent;
		border: none;
		outline: none;
		color: #fff;
		font-size: 0.85rem;
		width: 160px;
	}

	.searchbox input::placeholder {
		color: #bcd8d8;
	}

	.searchbox button {
		background: rgba(255, 255, 255, 0.15);
		border: none;
		border-radius: 50%;
		width: 30px;
		height: 30px;
		cursor: pointer;
	}

	@media (max-width: 900px) {
		.navbar-inner {
			flex-wrap: wrap;
		}

		.nav-toggle {
			display: flex;
		}

		.nav-panel {
			display: none;
			width: 100%;
			flex-direction: column;
		}

		.nav-panel.is-open {
			display: flex;
		}

		.searchbox {
			order: -1;
			display: flex;
			width: 100%;
			margin: 12px 0;
		}

		.searchbox input {
			flex: 1;
			width: auto;
		}

		.mainnav {
			width: 100%;
		}

		.mainnav ul {
			flex-direction: column;
		}

		.nav-item-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.mainnav > ul > li > .nav-item-row > a {
			flex: 1;
			padding: 14px 16px;
			white-space: normal;
		}

		.dropdown-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			background: transparent;
			border: none;
			color: #fff;
			padding: 14px 16px;
			cursor: pointer;
		}

		.chevron-icon {
			display: inline-block;
			transition: transform 0.2s ease;
		}

		.has-dropdown.is-expanded .chevron-icon {
			transform: rotate(180deg);
		}

		.dropdown {
			position: static;
			opacity: 1;
			visibility: visible;
			transform: none;
			border: none;
			box-shadow: none;
			min-width: 0;
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.2s ease;
		}
	}

	@media (max-width: 700px) {
		.brand-text small {
			display: none;
		}
		.topbar-links {
			display: none;
		}
	}
</style>
