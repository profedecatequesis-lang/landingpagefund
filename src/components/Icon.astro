---
interface Props {
	name: "facebook" | "instagram" | "whatsapp" | "youtube";
}

const { name } = Astro.props;
---

{name === "facebook" && (
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<path d="M15 3h-2.2C10.1 3 8.5 4.7 8.5 7.3V10H6v3.2h2.5V21h3.4v-7.8h2.6l.4-3.2h-3V7.6c0-.9.3-1.5 1.6-1.5H15V3z" />
	</svg>
)}

{name === "instagram" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
		<rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
		<circle cx="12" cy="12" r="4" />
		<circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
	</svg>
)}

{name === "whatsapp" && (
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.3A9 9 0 1 0 12 3Zm0 1.8a7.2 7.2 0 0 1 6.1 11 7.1 7.1 0 0 1-6.1 3.5 7.2 7.2 0 0 1-3.6-1l-.3-.2-2.6.7.7-2.5-.2-.3A7.2 7.2 0 0 1 12 4.8Zm-2.6 3.6c-.2 0-.4 0-.6.3-.2.2-.7.7-.7 1.7s.7 2 .9 2.1c.1.2 1.5 2.4 3.7 3.3 1.9.8 2.2.6 2.6.6.4 0 1.3-.5 1.5-1 .2-.5.2-1 .1-1.1-.1-.1-.3-.2-.5-.3l-1.6-.8c-.2-.1-.4-.1-.6.1l-.6.8c-.1.2-.3.2-.5.1-.3-.1-1-.4-2-1.2-.8-.6-1.3-1.4-1.4-1.7-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5l-.7-1.6c-.2-.4-.3-.4-.5-.4Z" />
	</svg>
)}

{name === "youtube" && (
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<rect x="2.5" y="6" width="19" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="1.7" />
		<path d="M10.5 9.5v5l4.5-2.5z" />
	</svg>
)}

<style>
	svg {
		width: 18px;
		height: 18px;
	}
</style>
