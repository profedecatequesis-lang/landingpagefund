---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionNav from "../components/SectionNav.astro";

interface NavItem {
	id: string;
	label: string;
}

interface Props {
	title: string;
	description: string;
	eyebrow: string;
	heroTitle: string;
	heroDescription: string;
	theme?: "teal" | "coral" | "mustard" | "deep";
	navItems: NavItem[];
}

const { title, description, eyebrow, heroTitle, heroDescription, theme, navItems } = Astro.props;
---

<Layout title={title} description={description}>
	<Header />
	<PageHeader eyebrow={eyebrow} title={heroTitle} description={heroDescription} theme={theme} />

	<section class="page-body">
		<div class="container page-grid">
			<main class="page-main">
				<slot />
			</main>
			<aside class="page-aside">
				<SectionNav items={navItems} />
			</aside>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	.page-body {
		padding: 56px 0 80px;
		background: var(--paper);
	}

	.page-grid {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 48px;
		align-items: start;
	}

	.page-main :global(section) {
		padding: 0 0 56px;
		scroll-margin-top: 140px;
	}

	.page-main :global(section:last-child) {
		padding-bottom: 0;
	}

	.page-main :global(h2) {
		font-size: 1.5rem;
	}

	@media (max-width: 900px) {
		.page-grid {
			grid-template-columns: 1fr;
		}
		.page-aside {
			order: -1;
		}
	}
</style>
