---
const base = import.meta.env.BASE_URL;
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Fundación Freinet — Capacitación docente y gestión educativa",
	description = "Capacitaciones con puntaje docente, asesoramiento educativo, servicios editoriales y formación para la gestión directiva. Córdoba, Argentina.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
